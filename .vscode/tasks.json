{
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}/firmware" },
  "presentation": { "panel": "dedicated", "clear": true },
  "tasks": [
    {
      "label": "IDF: build",
      "type": "shell",
      "command": "idf.py build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "IDF: set-target esp32p4",
      "type": "shell",
      "command": "idf.py set-target esp32p4",
      "problemMatcher": []
    },
    {
      "label": "IDF: flash + monitor",
      "type": "shell",
      "command": "idf.py -p ${config:idf.portWin} flash monitor",
      "problemMatcher": []
    },
    {
      "label": "IDF: monitor",
      "type": "shell",
      "command": "idf.py -p ${config:idf.portWin} monitor",
      "problemMatcher": []
    },
    {
      "label": "IDF: fullclean",
      "type": "shell",
      "command": "idf.py fullclean",
      "problemMatcher": []
    },
    {
      "label": "IDF: size-components",
      "type": "shell",
      "command": "idf.py size-components",
      "problemMatcher": []
    },
    {
      "label": "Gate: host_check (--app --tests)",
      "type": "shell",
      "command": "bash tools/scripts/host_check.sh --app --tests",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Gate: todos",
      "type": "shell",
      "command": "bash tools/scripts/check_all.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"]
    }
  ]
}
